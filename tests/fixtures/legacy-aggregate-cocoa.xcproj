  "targets": [
    {
      "name": "Cocoa Application",
      "id": "E525238B16245A900012E2BA",
      "product": "Products/Cocoa Application.app",
      "product-type": "application",
      "dependencies": [
        "Cocoa ApplicationImporter",
        "C/C++ Library",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        "headers",
        {
          "kind": "copy",
          "name": "Custom name copy",
          "bundle-base-path": "resources-directory",
        }, {
          "kind": "script",
          "name": "Custom name",
          "log-environment-variables": true,
          "shell": "/bin/sh",
          "script": "",
        },
      ],
      "build-rules": [
        {
          "processor": "com.apple.build-tasks.copy-strings-file",
          "file-type": "wrapper.xcclassmodel",
        }, {
          "processor": "com.apple.compilers.proxy.script",
          "file-type": "pattern.proxy",
          "file-patterns": "*.css",
          "output-files": [
            "${INPUT_FILE_BASE}.css.c",
          ],
          "script": "test\n",
        },
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "Cocoa Application/Cocoa Application.entitlements",
        "CODE_SIGN_IDENTITY": "Mac Developer",
        "COMBINE_HIDPI_IMAGES": "YES",
        "GCC_PRECOMPILE_PREFIX_HEADER": "YES",
        "GCC_PREFIX_HEADER": "Cocoa Application/Cocoa Application-Prefix.pch",
        "INFOPLIST_FILE": "Cocoa Application/Cocoa Application-Info.plist",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "WRAPPER_EXTENSION": "app",
      },
    }, {
      "name": "Cocoa ApplicationTests",
      "id": "E52523B216245A910012E2BA",
      "product": "Products/Cocoa ApplicationTests.octest",
      "product-type": "bundle",
      "dependencies": [
        { "kind": "remoteTarget", "project": "ReferencedProject.xcodeproj", "target": "ReferencedProject", "target-id": "E5FBB2E41635ED34009E96B0" },
        "Cocoa Application",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "script",
          "name": "Run Script",
          "shell": "/bin/sh",
          "script": [
            "# Run the unit tests in this test bundle.",
            "\"${SYSTEM_DEVELOPER_DIR}/Tools/RunUnitTests\"",
            "",
          ],
        },
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(BUILT_PRODUCTS_DIR)/Cocoa Application.app/Contents/MacOS/Cocoa Application",
        "COMBINE_HIDPI_IMAGES": "YES",
        "FRAMEWORK_SEARCH_PATHS": "\"$(DEVELOPER_LIBRARY_DIR)/Frameworks\"",
        "GCC_PRECOMPILE_PREFIX_HEADER": "YES",
        "GCC_PREFIX_HEADER": "Cocoa Application/Cocoa Application-Prefix.pch",
        "INFOPLIST_FILE": "Cocoa ApplicationTests/Cocoa ApplicationTests-Info.plist",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "TEST_HOST": "$(BUNDLE_LOADER)",
        "WRAPPER_EXTENSION": "octest",
      },
