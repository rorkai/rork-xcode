{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "de",
      "es",
      "fr",
      "it",
      "ja",
      "ru",
      "zh-Hans",
      "zh-Hant",
    ],
  },
  "files": [
    {
      "kind": "group",
      "path": "ScoreBoard",
      "children": [
        { "path": "ScoreBoard.entitlements" },
        { "path": "Info.plist" },
        {
          "kind": "folder",
          "path": "Helpers",
          "membership-exceptions": [
            {
              "target": "ScoreBoard",
              "inclusions": [
                "RankingEmoji.swift",
                "SamplePreview.swift",
              ],
            },
          ],
        }, {
          "kind": "folder",
          "path": "Models",
          "membership-exceptions": [
            {
              "target": "ScoreBoard",
              "inclusions": [
                "Game.swift",
                "Player.swift",
              ],
            },
          ],
        }, {
          "kind": "folder",
          "path": "Views",
          "membership-exceptions": [
            {
              "target": "ScoreBoard",
              "inclusions": [
                "GameListView.swift",
                "GameListViewCell.swift",
                "GameView.swift",
                "GameViewPlayerCellView.swift",
                "ScoreRoundPopover.swift",
              ],
            },
          ],
        },
        { "path": "ScoreBoardApp.swift", "target-membership": [ "ScoreBoard/compile-sources" ] },
        { "path": "Assets.xcassets", "target-membership": [ "ScoreBoard/resources" ] },
        { "path": "Splash.storyboard", "target-membership": [ { "build-phase": "ScoreBoard/resources", "platforms": [ "ios" ] } ] },
        {
          "kind": "group",
          "path": "Resources",
          "children": [
            { "path": "Localizable.xcstrings", "target-membership": [ "ScoreBoard/resources" ] },
            { "path": "InfoPlist.xcstrings", "target-membership": [ "ScoreBoard/resources" ] },
          ],
        }, {
          "kind": "group",
          "path": "Preview Content",
          "children": [
            { "path": "Preview Assets.xcassets", "target-membership": [ "ScoreBoard/resources" ] },
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "ScoreBoardUITests",
      "children": [
        { "path": "SnapshotHelper.swift", "target-membership": [ "ScoreBoardUITests/compile-sources" ] },
        { "path": "ScoreBoardUITests.swift", "target-membership": [ "ScoreBoardUITests/compile-sources" ] },
        { "path": "Snapshots.xctestplan", "target-membership": [ "ScoreBoardUITests/resources" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/ScoreBoard.app", "id": "3E7D82642C3892C4006B36EB", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/ScoreBoardUITests.xctest", "id": "3E1468052C39020A00BA1C9C", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "ScoreBoard",
      "id": "3E7D82632C3892C4006B36EB",
      "product": "Products/ScoreBoard.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        {
          "kind": "script",
          "name": "Run Script",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "if [[ \"$(uname -m)\" == arm64 ]]",
            "then",
            "    export PATH=\"/usr/local/bin:$PATH\"",
            "fi",
            "",
            "if command -v lint >/dev/null 2>&1",
            "then",
            "    lint",
            "else",
            "    echo \"warning: `lint` command not found - See https://example.com/lint for installation instructions.\"",
            "fi",
            "",
          ],
        },
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS": "YES",
        "CODE_SIGN_ENTITLEMENTS": "ScoreBoard/ScoreBoard.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "3",
        "DEVELOPMENT_ASSET_PATHS": "ScoreBoard/Helpers/SamplePreview.swift ScoreBoard/Preview\\ Content",
        "DEVELOPMENT_TEAM": "ABCDE12345",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "GCC_WARN_PEDANTIC": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "ScoreBoard/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "ScoreBoard",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UILaunchStoryboardName": "Splash.storyboard",
        "INFOPLIST_KEY_UIStatusBarHidden": "NO",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.3",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.example.ScoreBoard",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_STRICT_CONCURRENCY": "complete",
        "SWIFT_UPCOMING_FEATURE_CONCISE_MAGIC_FILE": "YES",
        "SWIFT_UPCOMING_FEATURE_DEPRECATE_APPLICATION_MAIN": "YES",
        "SWIFT_UPCOMING_FEATURE_DISABLE_OUTWARD_ACTOR_ISOLATION": "YES",
        "SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY": "YES",
        "SWIFT_UPCOMING_FEATURE_FORWARD_TRAILING_CLOSURES": "YES",
        "SWIFT_UPCOMING_FEATURE_GLOBAL_CONCURRENCY": "YES",
        "SWIFT_UPCOMING_FEATURE_IMPLICIT_OPEN_EXISTENTIALS": "YES",
        "SWIFT_UPCOMING_FEATURE_IMPORT_OBJC_FORWARD_DECLS": "YES",
        "SWIFT_UPCOMING_FEATURE_INFER_SENDABLE_FROM_CAPTURES": "YES",
        "SWIFT_UPCOMING_FEATURE_INTERNAL_IMPORTS_BY_DEFAULT": "YES",
        "SWIFT_UPCOMING_FEATURE_ISOLATED_DEFAULT_VALUES": "YES",
        "SWIFT_UPCOMING_FEATURE_REGION_BASED_ISOLATION": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "ScoreBoardUITests",
      "id": "3E1468042C39020A00BA1C9C",
      "product": "Products/ScoreBoardUITests.xctest",
      "product-type": "bundle.ui-testing",
      "test-host-target": "ScoreBoard",
      "dependencies": [
        "ScoreBoard",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
