          ],
          "input-file-lists": [
            "$(SRCROOT)/in.xcfilelist",
          ],
          "output-files": [
            "$(DERIVED_FILE_DIR)/$(INPUT_FILE_BASE).c",
          ],
          "output-file-lists": [
            "$(SRCROOT)/out.xcfilelist",
          ],
          "output-files-compiler-flags": [
            "-O2",
          ],
          "dependency-file": "$(DERIVED_FILE_DIR)/rule.d",
          "run-once-per-architecture": false,
          "script": [
            "first line",
            "second line",
            "",
          ],
        }, {
          "processor": "com.apple.compilers.yacc",
          "file-type": "sourcecode.yacc",
        },
